# API base URL (no trailing slash). Used by all requests in src/requests/. Must be VITE_* for Vite to expose it.
# Same-origin prefix: Docker nginx (and prod host nginx) proxy /api/ to Nest.
# Must include /api/v1. Rebuild the image after changing this (Vite bake).
VITE_BASE_URL=/api/v1

# Mailbox linked from "Contact your administrator" on the login screen.
# Leave empty to render that line as plain text with no link.
VITE_SUPPORT_EMAIL=

# Docker Compose variables
FRONTEND_IMAGE_NAME=z3c-frontend
FRONTEND_IMAGE_TAG=latest
FRONTEND_CONTAINER_NAME=z3c-frontend
FRONTEND_PORT=8080

# Browser origin(s) allowed in CSP connect-src (space-separated if several).
# Needed only if VITE_BASE_URL is an absolute cross-origin API URL.
CSP_CONNECT_SRC=http://localhost:5555

# Nest as this container reaches it. Default matches Nest on the Docker host
# (Backend/.env PORT=5555). Same-network backend: http://zatca-backend:5555
API_UPSTREAM=http://host.docker.internal:5555
