# API base URL (no trailing slash). Used by all requests in src/requests/. Must be VITE_* for Vite to expose it.
# Same-origin API prefix (host nginx proxies /api/ to the backend). Must include /api/v1.
VITE_BASE_URL=/api/v1

# Docker Compose variables
FRONTEND_IMAGE_NAME=z3c-frontend
FRONTEND_IMAGE_TAG=latest
FRONTEND_CONTAINER_NAME=z3c-frontend
FRONTEND_PORT=8080

# Browser origin(s) allowed in CSP connect-src (space-separated if several).
# Must match the API URL the SPA actually calls (VITE_BASE_URL origin).
CSP_CONNECT_SRC=http://localhost:5000
