[Unit]
Description=Sync frontend VITE_BASE_URL to current EC2 public IP and rebuild container
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/BOJ/Frontend
ExecStart=/opt/BOJ/Frontend/scripts/refresh-ip.sh
User=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
